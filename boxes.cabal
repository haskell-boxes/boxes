cabal-version:      1.24
name:               boxes
version:            0.2
synopsis:           2D text pretty-printing library
description:
  A pretty-printing library for laying out text in
  two dimensions, using a simple box model.

category:           Text
license:            BSD3
license-file:       LICENSE
author:             Brent Yorgey
maintainer:         Andreas Abel
build-type:         Simple

extra-doc-files:
  CHANGELOG.md
  README.md

tested-with:
  GHC == 9.14.1
  GHC == 9.12.2
  GHC == 9.10.3
  GHC == 9.8.4
  GHC == 9.6.7
  GHC == 9.4.8
  GHC == 9.2.8
  GHC == 9.0.2
  GHC == 8.10.7
  GHC == 8.8.4
  GHC == 8.6.5
  GHC == 8.4.4
  GHC == 8.2.2
  GHC == 8.0.2

library
  default-language:   Haskell2010
  build-depends:      base >=4.9 && <5
  hs-source-dirs:     src
  ghc-options:        -Wall

  exposed-modules:    Text.PrettyPrint.Boxes

test-suite test-boxes
  default-language:   Haskell2010
  type:               exitcode-stdio-1.0
  main-is:            Text/PrettyPrint/Tests.hs
  hs-source-dirs:     test
  ghc-options:        -Wall -Wno-orphans
  default-extensions: CPP
  build-depends:
      base        >=4.9    && <5
    , boxes
    , QuickCheck  >=2.14.2 && <2.18

source-repository head
  type:     git
  location: https://github.com/treeowl/boxes.git
